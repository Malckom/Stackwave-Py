From 2aa779b3ffb42993e6bf4d8cdb0bed33a62ee5d1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 10 Nov 2026 03:51:09 +0000
Subject: [PATCH] Serve Google Search Console HTML verification file from the
 site root

---
 app.py                                   | 12 ++++++++++++
 verification/README.txt                  |  3 +++
 verification/google7d8b1e1cd36c7648.html |  1 +
 3 files changed, 16 insertions(+)
 create mode 100644 verification/README.txt
 create mode 100644 verification/google7d8b1e1cd36c7648.html

diff --git a/app.py b/app.py
index aa5a3a4..61c9e24 100644
--- a/app.py
+++ b/app.py
@@ -287,6 +287,18 @@ def sitemap():
     return Response(xml, mimetype="application/xml")
 
 
+VERIFICATION_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "verification")
+
+
+@app.route("/google<token>.html")
+def google_verification(token):
+    """Serve Google Search Console's HTML verification file(s) from /verification at the site root."""
+    name = f"google{token}.html"
+    if not re.fullmatch(r"google[0-9a-f]{16}\.html", name):
+        abort(404)
+    return send_from_directory(VERIFICATION_DIR, name, mimetype="text/html")
+
+
 @app.route("/robots.txt")
 def robots():
     body = f"User-agent: *\nAllow: /\nDisallow: /admin\nDisallow: /onboarding\n\nSitemap: {site_url()}/sitemap.xml\n"
diff --git a/verification/README.txt b/verification/README.txt
new file mode 100644
index 0000000..1a6b946
--- /dev/null
+++ b/verification/README.txt
@@ -0,0 +1,3 @@
+Google Search Console HTML verification files live here and are served from the site root,
+e.g. /google7d8b1e1cd36c7648.html. Do not delete or edit them: Google re-checks them from time to time.
+To add another, drop the file Google gives you into this folder (its name must look like google<16 hex characters>.html).
diff --git a/verification/google7d8b1e1cd36c7648.html b/verification/google7d8b1e1cd36c7648.html
new file mode 100644
index 0000000..3463c1b
--- /dev/null
+++ b/verification/google7d8b1e1cd36c7648.html
@@ -0,0 +1 @@
+google-site-verification: google7d8b1e1cd36c7648.html
\ No newline at end of file
-- 
