diff --git a/templates/case-study.html b/templates/case-study.html
new file mode 100644
index 0000000..ed447dd
--- /dev/null
+++ b/templates/case-study.html
@@ -0,0 +1,120 @@
+{% extends "base.html" %}
+{% from "_macros.html" import project_frame, chip %}
+
+{% block title %}{{ project.name }} Case Study | Stackwave Developers{% endblock %}
+{% block meta_description %}{{ cs.intro }}{% endblock %}
+{% block body_class %}bg-background text-on-background font-body-md selection:bg-primary-container selection:text-white{% endblock %}
+
+{% block extra_style %}
+<style>
+  .mesh-bg {
+    background-color: #101415;
+    background-image:
+      radial-gradient(at 0% 0%, rgba(18, 74, 240, 0.18) 0px, transparent 50%),
+      radial-gradient(at 100% 0%, rgba(38, 254, 220, 0.1) 0px, transparent 50%);
+  }
+  .glass-card { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.05); }
+</style>
+{% endblock %}
+
+{% block content %}
+{% set status_label = {'live': 'Live', 'refurbishing': 'Being refurbished', 'in-build': 'In build'}.get(project.status, project.status) %}
+<main id="main" class="mesh-bg">
+
+  <!-- Hero -->
+  <header class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-desktop page-top pb-2xl">
+    <a class="link-arrow text-on-surface-variant text-label-md hover:text-primary mb-lg" href="{{ url_for('portfolio') }}"><span class="material-symbols-outlined" style="font-size:18px" aria-hidden="true">arrow_back</span>All projects</a>
+    <div class="grid grid-cols-1 lg:grid-cols-2 gap-xl items-center mt-md">
+      <div>
+        <div class="flex flex-wrap items-center gap-sm mb-md">
+          {{ chip(project.category, project.chip) }}
+          {{ chip(status_label, 'warn' if project.status != 'live' else 'mint') }}
+        </div>
+        <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-md">
+          {{ cs.headline_pre }} <span class="text-primary">{{ cs.headline_highlight }}</span>
+        </h1>
+        <p class="text-on-surface-variant text-body-lg mb-xl max-w-xl">{{ cs.intro }}</p>
+        <div class="flex flex-col sm:flex-row gap-md">
+          {% if project.url %}<a class="btn btn-primary" href="{{ project.url }}" target="_blank" rel="noopener">Visit live site <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span></a>{% endif %}
+          <a class="btn btn-ghost" href="{{ url_for('contact', service='Web Development', _anchor='inquiry-form') }}">Start a similar project</a>
+        </div>
+      </div>
+      <div>{{ project_frame(project, '16-10') }}</div>
+    </div>
+    {% if cs.banner %}
+    <div class="cs-banner mt-xl" role="note"><span class="material-symbols-outlined" aria-hidden="true">construction</span><span>{{ cs.banner }}</span></div>
+    {% endif %}
+  </header>
+
+  <!-- Challenge & solution -->
+  <section class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-desktop py-2xl" aria-labelledby="cs-challenge">
+    <div class="grid grid-cols-1 lg:grid-cols-2 gap-xl">
+      <div class="glass-card rounded-2xl p-xl">
+        <h2 id="cs-challenge" class="font-headline-lg text-headline-lg mb-md">The Challenge</h2>
+        <p class="text-on-surface-variant text-body-lg mb-lg">{{ cs.challenge }}</p>
+        <div class="flex flex-wrap gap-sm">{% for t in cs.challenge_tags %}{{ chip(t, 'muted') }}{% endfor %}</div>
+      </div>
+      <div class="glass-card rounded-2xl p-xl">
+        <h2 class="font-headline-lg text-headline-lg mb-md">The Solution</h2>
+        <p class="text-on-surface-variant text-body-lg mb-lg">{{ cs.solution }}</p>
+        <ul class="check-list">
+          {% for pt in cs.solution_points %}<li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span><span>{{ pt }}</span></li>{% endfor %}
+        </ul>
+      </div>
+    </div>
+  </section>
+
+  <!-- Features -->
+  <section class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-desktop py-2xl" aria-labelledby="cs-features">
+    <h2 id="cs-features" class="font-headline-lg text-headline-lg mb-xl">Key features</h2>
+    <div class="grid grid-cols-1 md:grid-cols-3 gap-lg">
+      {% for f in cs.features %}
+      <div class="glass-card hover-lift rounded-2xl p-xl">
+        <span class="material-symbols-outlined text-primary mb-md" style="font-size:36px" aria-hidden="true">{{ f.icon }}</span>
+        <h3 class="font-headline-md text-headline-md mb-sm">{{ f.title }}</h3>
+        <p class="text-on-surface-variant">{{ f.text }}</p>
+      </div>
+      {% endfor %}
+    </div>
+  </section>
+
+  <!-- Outcomes + at a glance -->
+  <section class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-desktop py-2xl" aria-labelledby="cs-outcomes">
+    <div class="grid grid-cols-1 lg:grid-cols-12 gap-xl items-start">
+      <div class="lg:col-span-7">
+        <h2 id="cs-outcomes" class="font-headline-lg text-headline-lg mb-lg">{{ 'Results' if cs.results else 'What we delivered' }}</h2>
+        {% if cs.results %}
+        <div class="metric-row mb-xl">{% for r in cs.results %}<div><strong>{{ r.value }}</strong><span>{{ r.label }}</span></div>{% endfor %}</div>
+        {% endif %}
+        <ul class="check-list">
+          {% for o in cs.outcomes %}<li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span><span>{{ o }}</span></li>{% endfor %}
+        </ul>
+      </div>
+      <aside class="lg:col-span-5">
+        <div class="side-panel">
+          <h2 class="font-headline-md text-headline-md mb-lg">At a glance</h2>
+          <dl class="cs-facts">
+            <div><dt>Sector</dt><dd>{{ project.type or project.category }}</dd></div>
+            <div><dt>Status</dt><dd>{{ status_label }}</dd></div>
+            <div><dt>Our role</dt><dd>Web design and development</dd></div>
+            {% if project.url %}<div><dt>Website</dt><dd><a class="text-primary underline" href="{{ project.url }}" target="_blank" rel="noopener">{{ project.domain }}</a></dd></div>{% endif %}
+            {% if cs.stack %}<div><dt>Built with</dt><dd><ul class="stack-list" style="margin-top:8px">{% for t in cs.stack %}<li>{{ t }}</li>{% endfor %}</ul></dd></div>{% endif %}
+          </dl>
+        </div>
+      </aside>
+    </div>
+  </section>
+
+  <!-- CTA -->
+  <section class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-desktop pb-3xl pt-xl">
+    <div class="bg-primary-container p-2xl rounded-[3rem] text-center flex flex-col items-center">
+      <h2 class="font-display-lg text-display-lg-mobile md:text-headline-lg text-on-primary-container mb-md">Have a project in mind?</h2>
+      <p class="text-on-primary-container/80 text-body-lg mb-xl max-w-xl">Tell us about your project and we'll reply by email with next steps.</p>
+      <div class="flex flex-col md:flex-row gap-md">
+        <a class="bg-on-primary-container text-primary-container px-2xl py-md rounded-full font-bold hover:scale-105 transition-transform" href="{{ url_for('contact', _anchor='inquiry-form') }}">Start Your Project</a>
+        <a class="border border-on-primary-container text-on-primary-container px-2xl py-md rounded-full font-bold hover:bg-on-primary-container/10 transition-all" href="{{ url_for('portfolio') }}">View More Work</a>
+      </div>
+    </div>
+  </section>
+</main>
+{% endblock %}
