+{% extends "legal.html" %}
+{% block title %}Terms &amp; Conditions | Stackwave Developers{% endblock %}
+{% block meta_description %}The terms that apply to using the Stackwave Developers website and to the web design, development, SEO and digital strategy services we provide.{% endblock %}
+{% block legal_title %}Terms &amp; Conditions{% endblock %}
+{% block legal_intro %}The terms that apply when you use this website or hire Stackwave Developers. We've kept them in plain language.{% endblock %}
+
+{% block legal_toc %}
+<li><a href="#about">About these terms</a></li>
+<li><a href="#services">Our services</a></li>
+<li><a href="#quotes">Quotes, scope and pricing</a></li>
+<li><a href="#payments">Payments</a></li>
+<li><a href="#your-responsibilities">Your responsibilities</a></li>
+<li><a href="#revisions">Revisions and delivery</a></li>
+<li><a href="#ip">Ownership and intellectual property</a></li>
+<li><a href="#third-parties">Third-party services</a></li>
+<li><a href="#support">Support after launch</a></li>
+<li><a href="#seo">SEO and performance</a></li>
+<li><a href="#website-use">Using this website</a></li>
+<li><a href="#liability">Liability</a></li>
+<li><a href="#confidentiality">Confidentiality</a></li>
+<li><a href="#termination">Ending a project</a></li>
+<li><a href="#law">Governing law</a></li>
+<li><a href="#changes">Changes to these terms</a></li>
+<li><a href="#contact">Contact us</a></li>
+{% endblock %}
+
+{% block legal_body %}
+<section id="about">
+  <h2>About these terms</h2>
+  <p>These terms apply to this website and to the services provided by <strong>Stackwave Developers</strong>, a business name registered in Kenya (registration number {{ site.business_reg_no }}), based in Nairobi. In these terms, "we", "us" and "our" mean Stackwave Developers, and "you" means the person or organization using the website or hiring us.</p>
+  <p>By using this website, or by accepting a quote or paying an invoice, you agree to these terms. If we agree different terms with you in writing for a particular project, those written terms take priority for that project.</p>
+</section>
+
+<section id="services">
+  <h2>Our services</h2>
