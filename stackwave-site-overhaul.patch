+<style>
+  .mesh-bg { background-color: #101415; background-image: radial-gradient(at 0% 0%, rgba(18, 74, 240, 0.15) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(38, 254, 220, 0.08) 0px, transparent 50%); }
