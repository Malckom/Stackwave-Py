diff --git a/scripts/build_media_kit.py b/scripts/build_media_kit.py
new file mode 100644
index 0000000..fecd1ad
--- /dev/null
+++ b/scripts/build_media_kit.py
@@ -0,0 +1,159 @@
+"""Regenerate static/downloads/Stackwave-Developers-Media-Kit.pdf from content/*.json.
+
+Run from the project root after editing pricing, projects or contact details:
+    pip install reportlab
+    python scripts/build_media_kit.py
+"""
+import json
+import os
+from xml.sax.saxutils import escape
+
+from reportlab.lib import colors
+from reportlab.lib.enums import TA_LEFT
+from reportlab.lib.pagesizes import A4
+from reportlab.lib.styles import ParagraphStyle
+from reportlab.lib.units import mm
+from reportlab.platypus import (BaseDocTemplate, Frame, PageBreak,
+                                PageTemplate, Paragraph, Spacer, Table, TableStyle)
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+OUT = os.path.join(ROOT, "static", "downloads", "Stackwave-Developers-Media-Kit.pdf")
+LOGO = os.path.join(ROOT, "static", "assets", "logo.png")
+
+
+def load(name):
+    with open(os.path.join(ROOT, "content", f"{name}.json"), encoding="utf-8") as f:
+        return json.load(f)
+
+
+site, pricing, projects, services = load("site"), load("pricing"), load("projects"), load("services")
+
+NAVY, BLUE, MINT = colors.HexColor("#101415"), colors.HexColor("#2e5bff"), colors.HexColor("#00b89f")
+INK, MUTED, RULE, TINT = colors.HexColor("#1b2230"), colors.HexColor("#5b6475"), colors.HexColor("#d9deea"), colors.HexColor("#f2f5ff")
+W, H = A4
+M = 20 * mm
+
+H1 = ParagraphStyle("h1", fontName="Helvetica-Bold", fontSize=22, leading=26, textColor=INK, spaceAfter=6)
+H2 = ParagraphStyle("h2", fontName="Helvetica-Bold", fontSize=13, leading=17, textColor=INK, spaceBefore=10, spaceAfter=4)
+BODY = ParagraphStyle("body", fontName="Helvetica", fontSize=10, leading=14.5, textColor=INK, alignment=TA_LEFT)
+SMALL = ParagraphStyle("small", parent=BODY, fontSize=8.5, leading=12, textColor=MUTED)
+CELL = ParagraphStyle("cell", parent=BODY, fontSize=9, leading=12.5)
+CELLB = ParagraphStyle("cellb", parent=CELL, fontName="Helvetica-Bold")
+EYEBROW = ParagraphStyle("eyebrow", fontName="Helvetica-Bold", fontSize=8.5, leading=11, textColor=MINT, spaceAfter=4)
+
+
+def p(text, style=BODY):
+    return Paragraph(escape(text), style)
+
+
+def cover(canvas, doc):
+    canvas.saveState()
+    canvas.setFillColor(NAVY)
+    canvas.rect(0, 0, W, H, stroke=0, fill=1)
+    canvas.setFillColor(colors.HexColor("#14203f"))
+    canvas.circle(W * 0.9, H * 0.88, 120 * mm, stroke=0, fill=1)
+    canvas.setFillColor(colors.HexColor("#0f2f33"))
+    canvas.circle(W * 0.05, H * 0.08, 90 * mm, stroke=0, fill=1)
+    canvas.drawImage(LOGO, M, H - 52 * mm, width=18 * mm, height=18 * mm * 394 / 469, mask="auto")
+    canvas.setFillColor(colors.white)
+    canvas.setFont("Helvetica-Bold", 38)
+    canvas.drawString(M, H * 0.52, "Media Kit")
+    canvas.setFont("Helvetica-Bold", 15)
+    canvas.setFillColor(colors.HexColor("#b8c3ff"))
+    canvas.drawString(M, H * 0.52 - 12 * mm, site["name"])
+    canvas.setFont("Helvetica", 11)
+    canvas.setFillColor(colors.HexColor("#c4c5d9"))
+    for i, line in enumerate(["Custom-coded websites and web platforms", "for Kenyan businesses and tour operators."]):
+        canvas.drawString(M, H * 0.52 - 22 * mm - i * 6 * mm, line)
+    canvas.setFillColor(BLUE)
+    canvas.rect(M, H * 0.52 - 34 * mm, 24 * mm, 1.6 * mm, stroke=0, fill=1)
+    canvas.setFillColor(colors.HexColor("#26fedc"))
+    canvas.rect(M + 24 * mm, H * 0.52 - 34 * mm, 24 * mm, 1.6 * mm, stroke=0, fill=1)
+    canvas.setFillColor(colors.HexColor("#c4c5d9"))
+    canvas.setFont("Helvetica", 9.5)
+    canvas.drawString(M, 24 * mm, f"{site['email']}   |   {site['phone_display']}   |   stackwavedevs.co.ke")
+    canvas.setFont("Helvetica", 8.5)
+    canvas.drawString(M, 18 * mm, f"{', '.join(site['office_lines'])}   |   Business registration {site['business_reg_no']}")
+    canvas.restoreState()
+
+
+def inner(canvas, doc):
+    canvas.saveState()
+    canvas.setFillColor(NAVY)
+    canvas.rect(0, H - 10 * mm, W, 10 * mm, stroke=0, fill=1)
+    canvas.setFillColor(colors.white)
+    canvas.setFont("Helvetica-Bold", 8.5)
+    canvas.drawString(M, H - 6.4 * mm, "STACKWAVE DEVELOPERS  |  MEDIA KIT")
+    canvas.setStrokeColor(RULE)
+    canvas.line(M, 14 * mm, W - M, 14 * mm)
+    canvas.setFillColor(MUTED)
+    canvas.setFont("Helvetica", 8)
+    canvas.drawString(M, 9.5 * mm, f"{site['email']}  |  {site['phone_display']}  |  stackwavedevs.co.ke")
+    canvas.drawRightString(W - M, 9.5 * mm, f"Page {doc.page}")
+    canvas.restoreState()
+
+
+def table(rows, widths, header=True):
+    t = Table(rows, colWidths=widths, repeatRows=1 if header else 0)
+    style = [("VALIGN", (0, 0), (-1, -1), "TOP"), ("LINEBELOW", (0, 0), (-1, -1), 0.4, RULE),
+             ("TOPPADDING", (0, 0), (-1, -1), 5), ("BOTTOMPADDING", (0, 0), (-1, -1), 5),
+             ("LEFTPADDING", (0, 0), (-1, -1), 4), ("RIGHTPADDING", (0, 0), (-1, -1), 4)]
+    if header:
+        style += [("BACKGROUND", (0, 0), (-1, 0), TINT)]
+    t.setStyle(TableStyle(style))
+    return t
+
+
+def package_price(pkg):
+    return pkg["price"] if pkg["price"] else "From " + pkg["tiers"][0]["price"].split("–")[0]
+
+
+def build():
+    doc = BaseDocTemplate(OUT, pagesize=A4, leftMargin=M, rightMargin=M, topMargin=22 * mm, bottomMargin=22 * mm,
+                          title="Stackwave Developers Media Kit", author=site["name"])
+    full = Frame(0, 0, W, H, id="cover")
+    body = Frame(M, 22 * mm, W - 2 * M, H - 44 * mm, id="body", leftPadding=0, rightPadding=0, topPadding=0, bottomPadding=0)
+    doc.addPageTemplates([PageTemplate(id="cover", frames=[full], onPage=cover),
+                          PageTemplate(id="inner", frames=[body], onPage=inner)])
+    from reportlab.platypus import NextPageTemplate
+    s = [NextPageTemplate("inner"), PageBreak()]
+
+    # About + services
+    s += [p("ABOUT US", EYEBROW), p("A Nairobi web studio that builds things from scratch", H1),
+          p(f"{site['name']} designs and builds custom-coded websites and web platforms for Kenyan businesses and tour operators. "
+            "Every project is hand-built rather than assembled from a drag-and-drop template, with local payment options "
+            "such as M-Pesa Daraja and Paystack built in where they are needed.")
+          , Spacer(1, 4),
+          p("We work with Node.js and Express, Python and Flask, and React, and we know the tour and travel industry first-hand.", BODY),
+          Spacer(1, 8), p("What we do", H2)]
+    rows = [[p("Web Design & Architecture", CELLB), p("Custom-coded sites and platforms, from five-page business sites to booking engines and dashboards.", CELL)]]
+    for sv in services:
+        rows.append([p(sv["card_title"], CELLB), p(sv["card_text"], CELL)])
+    s += [table(rows, [48 * mm, W - 2 * M - 48 * mm], header=False), Spacer(1, 10)]
+
+    # Work
+    s += [p("SELECTED WORK", EYEBROW), p("Sites and platforms we've built", H1)]
+    status = {"live": "Live", "refurbishing": "Being refurbished", "in-build": "In build", "coming-soon": "Details coming soon"}
+    rows = [[p("Project", CELLB), p("Type", CELLB), p("Status", CELLB), p("Website", CELLB)]]
+    for pr in projects:
+        url = (pr["url"] or "").replace("https://", "").replace("http://", "").rstrip("/")
+        rows.append([p(pr["name"], CELLB), p(pr.get("type") or pr["category"], CELL), p(status.get(pr["status"], pr["status"]), CELL), p(url or "n/a", CELL)])
+    s += [table(rows, [52 * mm, 38 * mm, 34 * mm, W - 2 * M - 124 * mm]), PageBreak()]
+
+    # Pricing
+    s += [p("PACKAGES & PRICING", EYEBROW), p("Transparent starting prices", H1),
+          p(pricing["currency_note"] + ". These are starting prices; your final quote depends on page count, features, content readiness and integrations. To request a quote, email " + site["email"] + " or call " + site["phone_display"] + ".", SMALL),
+          Spacer(1, 8)]
+    rows = [[p("Package", CELLB), p("Starting price", CELLB), p("Timeline", CELLB), p("What's included", CELLB)]]
+    for pk in pricing["packages"]:
+        rows.append([p(pk["name"], CELLB), p(package_price(pk), CELL), p(pk["timeline"], CELL), p("; ".join(pk["features"][:3]), CELL)])
+    s += [table(rows, [38 * mm, 34 * mm, 24 * mm, W - 2 * M - 96 * mm]), Spacer(1, 6), p("Add-on services", H2)]
+    rows = [[p("Service", CELLB), p("Price", CELLB)]] + [[p(a["name"] + " (" + a["detail"] + ")", CELL), p(a["price"], CELL)] for a in pricing["addons"]]
+    s += [table(rows, [W - 2 * M - 50 * mm, 50 * mm]), Spacer(1, 10), p("Notes", H2)]
+    s += [p("•  " + n, SMALL) for n in pricing["notes"]]
+    doc.build(s)
+    print("wrote", OUT, os.path.getsize(OUT), "bytes")
+
+
+if __name__ == "__main__":
+    build()
diff --git a/static/css/site.css b/static/css/site.css
new file mode 100644
index 0000000..89a3c89
--- /dev/null
+++ b/static/css/site.css
@@ -0,0 +1,469 @@
+/* =====================================================================
+   Stackwave: site.css
+   Hand-written layer that sits on top of the compiled Tailwind stylesheet
+   (static/css/styles.css). The Tailwind config isn't in this repo, so new
+   components live here instead of requiring a rebuild.
+   ===================================================================== */
+
+:root {
+  --sw-bg: #101415;
+  --sw-bg-lowest: #0b0f10;
+  --sw-bg-low: #191c1e;
+  --sw-surface: #1d2022;
+  --sw-surface-high: #272a2c;
+  --sw-surface-highest: #323537;
+  --sw-primary: #b8c3ff;
+  --sw-blue: #2e5bff;
+  --sw-mint: #26fedc;
+  --sw-mint-dim: #00dfc1;
+  --sw-text: #e0e3e5;
+  --sw-muted: #c4c5d9;
+  --sw-outline: #8e90a2;
+  --sw-outline-variant: #434656;
+  --sw-error: #ffb4ab;
+  --sw-glass: rgba(30, 41, 59, 0.7);
+  --sw-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
+  --sw-nav-h: 72px;
+}
+
+/* ---------- Layout helpers (named, since arbitrary Tailwind values aren't compiled) ---------- */
+.page-top { padding-top: 8.5rem; }
+.w-medium { max-width: 1100px; }
+.w-legal { max-width: 1120px; }
+.w-narrow { max-width: 900px; }
+.underline { text-decoration-line: underline; }
+
+/* ---------- Base ---------- */
+/* Decorative glows and blurred shapes can poke past the viewport on phones; clip rather than scroll sideways. */
+html, body { overflow-x: hidden; }
+@supports (overflow: clip) { html, body { overflow-x: clip; } }
+.pricing-grid > *, .service-links > *, .project-grid > *, .steps > *, .addon-list > *, .notes-list > * { min-width: 0; }
+@media (max-width: 1023px) { .bento-perf { flex-direction: column; align-items: flex-start; } }
+html { scroll-behavior: smooth; scroll-padding-top: 96px; }
+[hidden] { display: none !important; }
+:focus-visible { outline: 2px solid var(--sw-primary); outline-offset: 3px; border-radius: 4px; }
+.visually-hidden {
+  position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0;
+  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
+}
+.skip-link {
+  position: absolute; left: 16px; top: -48px; z-index: 100; padding: 10px 16px;
+  background: var(--sw-blue); color: #fff; border-radius: 8px; transition: top 0.2s ease;
+}
+.skip-link:focus { top: 12px; }
+.brand-icon { display: block; }
+
+/* ---------- Buttons ---------- */
+.btn {
+  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
+  padding: 14px 28px; border-radius: 999px; border: 1px solid transparent;
+  font-family: Montserrat, sans-serif; font-weight: 600; font-size: 16px; line-height: 1;
+  text-decoration: none; cursor: pointer; transition: all 0.3s ease;
+}
+.btn:focus-visible { outline-offset: 4px; border-radius: 999px; }
+.btn-primary { background: var(--sw-blue); color: #efefff; }
+.btn-primary:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 0 26px rgba(46, 91, 255, 0.55); }
+.btn-ghost { border-color: var(--sw-mint); color: var(--sw-mint); }
+.btn-ghost:hover { background: rgba(38, 254, 220, 0.1); transform: translateY(-2px); box-shadow: 0 0 22px rgba(38, 254, 220, 0.25); }
+.btn-outline { border-color: rgba(255, 255, 255, 0.22); color: var(--sw-text); }
+.btn-outline:hover { background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.4); transform: translateY(-2px); }
+.btn-sm { padding: 10px 20px; font-size: 14px; }
+.btn[disabled] { opacity: 0.6; cursor: wait; transform: none; box-shadow: none; }
+
+/* ---------- Navigation ---------- */
+.nav-actions { display: flex; align-items: center; gap: 10px; }
+.btn-quote {
+  display: inline-block; background: var(--sw-blue); color: #efefff; padding: 10px 22px; border-radius: 999px;
+  font-family: Inter, sans-serif; font-weight: 500; font-size: 14px; letter-spacing: 0.05em; text-decoration: none;
+  white-space: nowrap; transition: all 0.3s ease;
+}
+.btn-quote:hover { transform: translateY(-1px) scale(1.04); box-shadow: 0 0 22px rgba(46, 91, 255, 0.55); }
+.nav-toggle {
+  display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; cursor: pointer;
+  border: 1px solid rgba(255, 255, 255, 0.14); background: transparent; color: var(--sw-text); transition: all 0.3s ease;
+}
+.nav-toggle:hover { border-color: rgba(184, 195, 255, 0.5); background: rgba(255, 255, 255, 0.05); }
+.nav-toggle .icon-close { display: none; }
+.nav-toggle[aria-expanded="true"] .icon-open { display: none; }
+.nav-toggle[aria-expanded="true"] .icon-close { display: inline; }
+.mobile-menu { display: none; border-top: 1px solid rgba(255, 255, 255, 0.08); background: rgba(16, 20, 21, 0.97); backdrop-filter: blur(20px); }
+.mobile-menu.is-open { display: block; }
+.mobile-menu a {
+  display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; color: var(--sw-muted);
+  text-decoration: none; font-weight: 500; border-bottom: 1px solid rgba(255, 255, 255, 0.05); transition: all 0.3s ease;
+}
+.mobile-menu a:hover, .mobile-menu a[aria-current="page"] { color: var(--sw-primary); background: rgba(255, 255, 255, 0.03); }
+.nav-links { display: none; }
+@media (min-width: 1024px) {
+  .nav-links { display: flex; }
+  .nav-toggle { display: none; }
+  .mobile-menu, .mobile-menu.is-open { display: none; }
+}
+@media (max-width: 400px) { .btn-quote { padding: 9px 16px; } }
+
+/* ---------- Toast (form confirmations) ---------- */
+.toast-region {
+  position: fixed; top: 88px; left: 50%; transform: translateX(-50%); z-index: 70;
+  display: flex; flex-direction: column; gap: 12px; width: min(92vw, 440px); pointer-events: none;
+}
+.toast {
+  --toast-ms: 7000ms;
+  position: relative; display: flex; align-items: flex-start; gap: 14px; overflow: hidden;
+  padding: 16px 18px 20px; border-radius: 18px; pointer-events: auto;
+  background: rgba(20, 26, 38, 0.94); backdrop-filter: blur(18px);
+  border: 1px solid rgba(38, 254, 220, 0.28);
+  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(38, 254, 220, 0.1);
+  animation: toast-in 0.5s var(--sw-ease) both, toast-out 0.5s ease var(--toast-ms) forwards;
+}
+.toast--error { border-color: rgba(255, 180, 171, 0.4); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(255, 180, 171, 0.08); }
+.toast:hover, .toast:focus-within { animation-play-state: paused; }
+.toast:hover .toast-progress, .toast:focus-within .toast-progress { animation-play-state: paused; }
+.toast-icon {
+  flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
+  background: rgba(38, 254, 220, 0.14); color: var(--sw-mint);
+}
+.toast--error .toast-icon { background: rgba(255, 180, 171, 0.14); color: var(--sw-error); }
+.toast-icon svg { width: 20px; height: 20px; }
+.toast-check { stroke-dasharray: 24; stroke-dashoffset: 24; animation: toast-draw 0.5s ease 0.25s forwards; }
+.toast-text { flex: 1; min-width: 0; }
+.toast-title { font-family: Montserrat, sans-serif; font-weight: 600; font-size: 16px; line-height: 1.3; color: var(--sw-text); }
+.toast-body { margin-top: 2px; font-size: 14px; line-height: 1.5; color: var(--sw-muted); }
+.toast-close {
+  flex: none; display: grid; place-items: center; width: 28px; height: 28px; margin: -4px -6px 0 0; border-radius: 8px;
+  border: 0; background: transparent; color: var(--sw-outline); cursor: pointer; transition: all 0.3s ease;
+}
+.toast-close:hover { color: var(--sw-text); background: rgba(255, 255, 255, 0.08); }
+.toast-progress {
+  position: absolute; left: 0; bottom: 0; width: 100%; height: 3px; transform-origin: left;
+  background: linear-gradient(90deg, var(--sw-primary), var(--sw-mint));
