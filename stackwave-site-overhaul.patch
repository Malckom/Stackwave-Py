+}
+.social-links--contact a { width: 48px; height: 48px; }
+
+/* ---------- Footer ---------- */
+.contact-block { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; font-style: normal; }
+.contact-block li { display: flex; align-items: flex-start; gap: 12px; font-size: 14px; line-height: 1.5; color: #9ca3af; }
+.contact-block .ic { flex: none; display: grid; place-items: center; width: 20px; height: 22px; color: var(--sw-mint-dim); }
+.contact-block a, .contact-block span { overflow-wrap: anywhere; min-width: 0; }
+.contact-block a { color: #9ca3af; text-decoration: none; transition: color 0.3s ease; }
+.contact-block a:hover { color: #fff; }
+.footer-legal { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 28px; }
+
+/* ---------- Service detail pages ---------- */
+.sd-hero { position: relative; overflow: hidden; text-align: center; }
+.steps { display: grid; gap: 20px; grid-template-columns: 1fr; margin: 0; padding: 0; list-style: none; counter-reset: step; }
+@media (min-width: 768px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (min-width: 1024px) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
+.step { position: relative; padding: 24px; border-radius: 16px; counter-increment: step; background: var(--sw-glass); border: 1px solid rgba(255, 255, 255, 0.05); transition: all 0.3s ease; }
+.step::before {
+  content: counter(step); display: grid; place-items: center; width: 36px; height: 36px; margin-bottom: 16px; border-radius: 50%;
+  background: rgba(46, 91, 255, 0.22); color: var(--sw-primary); font-family: Montserrat, sans-serif; font-weight: 700; font-size: 16px;
+}
+.step:hover { transform: translateY(-4px); border-color: rgba(184, 195, 255, 0.4); }
+.step h3 { margin: 0 0 8px; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 20px; color: var(--sw-text); }
+.step p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--sw-muted); }
+.check-list { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
+.check-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 16px; line-height: 1.5; color: var(--sw-text); }
+.check-list .material-symbols-outlined { flex: none; margin-top: 1px; font-size: 22px; color: var(--sw-mint); }
