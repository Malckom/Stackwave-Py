+.faq summary::after { content: "+"; flex: none; font-family: Inter, sans-serif; font-weight: 400; font-size: 26px; line-height: 1; color: var(--sw-primary); transition: transform 0.3s ease; }
+.faq details[open] summary::after { transform: rotate(45deg); }
+.faq-answer { max-width: 68ch; margin: 0; padding: 0 22px 20px; line-height: 1.7; color: var(--sw-muted); }
+.service-links { display: grid; gap: 16px; grid-template-columns: 1fr; }
+@media (min-width: 768px) { .service-links { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (min-width: 1024px) { .service-links { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
+.service-link-card { display: flex; align-items: center; gap: 16px; padding: 20px 24px; border-radius: 16px; text-decoration: none; color: var(--sw-text); background: var(--sw-glass); border: 1px solid rgba(255, 255, 255, 0.06); transition: all 0.3s ease; }
+.service-link-card:hover { transform: translateY(-4px); border-color: rgba(184, 195, 255, 0.45); box-shadow: 0 14px 32px rgba(0, 0, 0, 0.35); }
+.service-link-card .material-symbols-outlined:first-child { font-size: 32px; color: var(--sw-primary); }
+.service-link-card strong { display: block; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 18px; }
+.service-link-card span.sub { display: block; margin-top: 2px; font-size: 13px; color: var(--sw-muted); }
+.service-link-card .arrow { margin-left: auto; transition: transform 0.3s ease; color: var(--sw-primary); }
+.service-link-card:hover .arrow { transform: translateX(4px); }
+
+/* ---------- Case study (generated) ---------- */
+.cs-banner { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 12px; background: rgba(255, 200, 120, 0.08); border: 1px solid rgba(255, 200, 120, 0.3); color: #ffd9a0; font-size: 14px; }
+.cs-facts { display: grid; gap: 16px; margin: 0; }
+.cs-facts dt { font-size: 12px; font-weight: 600; color: var(--sw-outline); }
+.cs-facts dd { margin: 2px 0 0; font-size: 15px; color: var(--sw-text); }
+.stack-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
+.stack-list li { padding: 5px 12px; border-radius: 8px; background: var(--sw-surface-highest); color: var(--sw-text); font-size: 13px; font-weight: 500; }
+.metric-row { display: flex; flex-wrap: wrap; gap: 32px; }
+.metric-row strong { display: block; font-family: Montserrat, sans-serif; font-weight: 700; font-size: 40px; line-height: 1.1; color: var(--sw-mint); }
+.metric-row span { font-size: 13px; color: var(--sw-muted); }
+
+/* ---------- Legal pages ---------- */
+.legal-layout { display: grid; gap: 40px; max-width: 1120px; margin: 0 auto; padding: 0 20px; }
+@media (min-width: 768px) { .legal-layout { padding: 0 48px; } }
+@media (min-width: 1024px) { .legal-layout { grid-template-columns: 250px minmax(0, 1fr); gap: 64px; } }
+.legal-toc { align-self: start; padding: 20px; border-radius: 16px; background: var(--sw-glass); border: 1px solid rgba(255, 255, 255, 0.06); }
+@media (min-width: 1024px) { .legal-toc { position: sticky; top: 100px; } }
+.legal-toc h2 { margin: 0 0 10px; font-size: 13px; font-weight: 600; color: var(--sw-outline); }
+.legal-toc ol { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
+.legal-toc a { display: block; padding: 5px 8px; border-radius: 8px; font-size: 14px; line-height: 1.4; color: var(--sw-muted); text-decoration: none; transition: all 0.3s ease; }
+.legal-toc a:hover { color: var(--sw-primary); background: rgba(255, 255, 255, 0.04); }
+.prose-legal { min-width: 0; }
+.prose-legal section { scroll-margin-top: 100px; }
+.prose-legal h2 { margin: 48px 0 12px; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 24px; line-height: 1.3; color: var(--sw-text); }
+.prose-legal section:first-of-type h2 { margin-top: 0; }
+.prose-legal h3 { margin: 24px 0 8px; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 18px; color: var(--sw-text); }
+.prose-legal p, .prose-legal li { max-width: 72ch; font-size: 16px; line-height: 1.75; color: var(--sw-muted); }
+.prose-legal p { margin: 0 0 14px; }
+.prose-legal ul { margin: 0 0 16px; padding-left: 1.25rem; list-style: disc; }
+.prose-legal li { margin-bottom: 6px; }
+.prose-legal a { color: var(--sw-primary); text-decoration: underline; text-underline-offset: 3px; }
+.prose-legal strong { color: var(--sw-text); font-weight: 600; }
+.prose-legal table { width: 100%; max-width: 72ch; margin: 0 0 20px; border-collapse: collapse; font-size: 14px; }
+.prose-legal th, .prose-legal td { padding: 10px 12px; text-align: left; vertical-align: top; border-bottom: 1px solid rgba(255, 255, 255, 0.08); color: var(--sw-muted); }
+.prose-legal th { color: var(--sw-text); font-weight: 600; }
+.table-scroll { overflow-x: auto; }
+
+/* ---------- 404 ---------- */
+.nf-code { font-family: Montserrat, sans-serif; font-weight: 700; font-size: clamp(5rem, 3rem + 12vw, 10rem); line-height: 1; letter-spacing: -0.04em; background: linear-gradient(135deg, #b8c3ff, #26fedc); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
+
+/* ---------- Reduced motion ---------- */
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after { transition-duration: 0.01ms !important; }
+  .hv-float, .hv-float-slow, .hero-badge i { animation: none !important; }
+  .toast { animation: toast-in 0.01s both, toast-out 0.01s var(--toast-ms) forwards; }
+  .toast-progress { animation: none; display: none; }
+  .toast-check { animation: none; stroke-dashoffset: 0; }
+  .btn:hover, .plan:hover, a.project-card:hover, .project-tile:hover .browser-frame, .bento-card:hover, .hover-lift:hover, .step:hover,
+  .service-link-card:hover, .addon-box:hover, .social-links a:hover, .btn-quote:hover { transform: none; }
+}
