+.addon-text { flex: 1; min-width: 0; }
+.addon-name { display: block; font-size: 15px; font-weight: 600; line-height: 1.35; color: var(--sw-text); }
+.addon-detail { display: block; margin-top: 2px; font-size: 13px; line-height: 1.4; color: var(--sw-outline); }
+.addon-price { flex: none; font-size: 14px; font-weight: 700; white-space: nowrap; color: var(--sw-text); text-align: right; }
+.addon-bar {
+  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-top: 28px; padding: 16px 20px;
+  border-radius: 14px; background: rgba(46, 91, 255, 0.12); border: 1px solid rgba(46, 91, 255, 0.4);
+}
+.addon-bar p { margin: 0; font-size: 14px; color: var(--sw-text); }
+.notes-list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; grid-template-columns: 1fr; }
+@media (min-width: 768px) { .notes-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } .notes-list li:last-child:nth-child(odd) { grid-column: 1 / -1; } }
+.notes-list li { display: flex; align-items: flex-start; gap: 8px; font-size: 14px; line-height: 1.55; color: var(--sw-muted); }
+.notes-list .material-symbols-outlined { flex: none; margin-top: 1px; font-size: 18px; color: var(--sw-primary); }
+
+/* ---------- Contact form ---------- */
+#inquiry-form { scroll-margin-top: 100px; }
+.selection { margin-bottom: 28px; padding: 20px 22px; border-radius: 16px; background: rgba(46, 91, 255, 0.1); border: 1px solid rgba(46, 91, 255, 0.38); }
+.selection-title { margin: 0 0 4px; font-size: 13px; font-weight: 600; color: var(--sw-primary); }
+.selection-name { margin: 0; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 20px; color: var(--sw-text); }
+.selection-meta { margin: 4px 0 0; font-size: 14px; color: var(--sw-muted); }
