+.project-card-link { margin-top: auto; padding-top: 8px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--sw-primary); }
+.project-card-link .material-symbols-outlined { font-size: 16px; transition: transform 0.3s ease; }
+a.project-card:hover .project-card-link .material-symbols-outlined { transform: translateX(4px); }
+.project-card-title-sm { margin: 16px 0 2px; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 20px; color: var(--sw-text); transition: color 0.3s ease; }
+.project-tile { display: block; text-decoration: none; color: inherit; transition: all 0.3s ease; }
+.project-tile .browser-frame { transition: all 0.3s ease; }
+.project-tile:hover .browser-frame, .project-tile:focus-visible .browser-frame { transform: translateY(-6px); border-color: rgba(184, 195, 255, 0.45); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4), 0 0 26px rgba(46, 91, 255, 0.2); }
+.project-tile:hover .browser-logo { transform: scale(1.05); }
+.project-tile:hover .project-card-title-sm { color: var(--sw-primary); }
+.project-tile-meta { font-size: 12px; font-weight: 500; color: var(--sw-outline); }
+
+/* ---------- Generic micro-interactions ---------- */
+.bento-card { transition: all 0.3s ease; }
+.bento-card:hover, .bento-card:focus-visible { transform: translateY(-4px); border-color: rgba(184, 195, 255, 0.4); box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35), 0 0 24px rgba(184, 195, 255, 0.1); }
+.glass-card:hover { border-color: rgba(184, 195, 255, 0.35); box-shadow: 0 0 22px rgba(184, 195, 255, 0.08); transition: all 0.3s ease; }
+.hover-lift { transition: all 0.3s ease; }
+.hover-lift:hover { transform: translateY(-4px); border-color: rgba(184, 195, 255, 0.4); box-shadow: 0 14px 32px rgba(0, 0, 0, 0.35), 0 0 22px rgba(184, 195, 255, 0.1); }
+.link-arrow { display: inline-flex; align-items: center; gap: 6px; transition: all 0.3s ease; }
+.link-arrow:hover { gap: 12px; }
+
+/* ---------- Pricing ---------- */
+.pricing-grid { display: grid; gap: 32px; grid-template-columns: 1fr; }
+@media (min-width: 768px) { .pricing-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .plan--featured, .plan--help { grid-column: 1 / -1; } }
+@media (min-width: 1280px) { .pricing-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .plan--featured, .plan--help { grid-column: auto; } }
+.plan {
+  position: relative; display: flex; flex-direction: column; padding: 32px; border-radius: 20px; background: #1e293b;
+  transition: all 0.3s ease;
+}
+@media (min-width: 768px) { .plan { padding: 40px; } }
+.plan::before {
+  content: ""; position: absolute; inset: -1px; border-radius: 21px; padding: 1px; pointer-events: none;
+  background: linear-gradient(to right, #b8c3ff, #26fedc);
+  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
+  -webkit-mask-composite: xor; mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude;
+  opacity: 0.25; transition: opacity 0.3s ease;
+}
+.plan:hover { transform: translateY(-6px); box-shadow: 0 20px 44px rgba(0, 0, 0, 0.4), 0 0 28px rgba(46, 91, 255, 0.18); }
+.plan:hover::before, .plan--featured::before { opacity: 1; }
+.plan--featured { background: linear-gradient(180deg, rgba(184, 195, 255, 0.09) 0%, #1e293b 32%); }
+.plan-badge {
+  align-self: flex-start; margin-bottom: 20px; padding: 5px 14px; border-radius: 999px;
+  background: var(--sw-mint); color: #00382f; font-size: 12px; font-weight: 700; letter-spacing: 0.06em;
+}
+.plan-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; color: var(--sw-primary); }
+.plan-head .material-symbols-outlined { flex: none; font-size: 32px; }
+.plan--featured .plan-head { color: var(--sw-mint); }
+.plan-head h2 { margin: 0; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 22px; line-height: 1.3; color: var(--sw-text); }
+.plan-summary { margin: 0 0 24px; font-size: 14px; line-height: 1.6; color: var(--sw-muted); }
+.plan-price { margin: 0 0 24px; font-family: Montserrat, sans-serif; font-weight: 700; font-size: clamp(1.5rem, 1.1rem + 1.1vw, 2rem); line-height: 1.15; letter-spacing: -0.01em; color: var(--sw-text); text-wrap: balance; }
+.plan-tiers { display: grid; gap: 14px; margin: 0 0 24px; padding: 16px 0 0; border-top: 1px solid rgba(255, 255, 255, 0.1); list-style: none; }
+.plan-tiers li { display: flex; flex-direction: column; gap: 2px; font-size: 14px; color: var(--sw-muted); }
+.plan-tiers strong { color: var(--sw-text); font-weight: 700; }
+.plan-features { display: grid; flex: 1; align-content: start; gap: 12px; margin: 0 0 32px; padding: 0; list-style: none; }
+.plan-features li { display: flex; align-items: flex-start; gap: 8px; font-size: 14px; line-height: 1.5; color: var(--sw-muted); }
+.plan-features .material-symbols-outlined { flex: none; margin-top: 1px; font-size: 18px; color: var(--sw-mint); }
+.plan-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 16px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
+.plan-timeline { font-size: 13px; font-weight: 500; color: var(--sw-muted); }
+.plan--help { justify-content: center; background: rgba(30, 41, 59, 0.45); border: 1px dashed rgba(184, 195, 255, 0.35); }
+.plan--help::before { display: none; }
+.plan--help h2 { font-family: Montserrat, sans-serif; font-weight: 600; font-size: 22px; margin: 0 0 8px; color: var(--sw-text); }
+
+.addons { padding: 32px; border-radius: 20px; background: var(--sw-glass); border: 1px solid rgba(255, 255, 255, 0.05); backdrop-filter: blur(12px); }
+@media (min-width: 768px) { .addons { padding: 48px; } }
+.addons-head { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; color: var(--sw-primary); }
+.addons-head .material-symbols-outlined { font-size: 32px; }
+.addons-head h2 { margin: 0; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 24px; color: var(--sw-text); }
+.addons-intro { margin: 0 0 32px; max-width: 42rem; font-size: 14px; line-height: 1.6; color: var(--sw-muted); }
+.addon-list { display: grid; gap: 14px; grid-template-columns: 1fr; margin: 0; padding: 0; list-style: none; }
+@media (min-width: 768px) { .addon-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 24px; } }
+.addon { display: block; height: 100%; }
+.addon-input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
+.addon-box {
+  display: flex; align-items: center; gap: 16px; height: 100%; padding: 16px 18px; border-radius: 14px; cursor: pointer;
+  background: rgba(11, 15, 16, 0.45); border: 1px solid rgba(255, 255, 255, 0.08); transition: all 0.3s ease;
+}
+.addon-box:hover { border-color: rgba(184, 195, 255, 0.45); transform: translateY(-2px); }
+.addon-input:focus-visible + .addon-box { outline: 2px solid var(--sw-primary); outline-offset: 3px; }
+.addon-input:checked + .addon-box { border-color: var(--sw-mint); background: rgba(38, 254, 220, 0.06); box-shadow: 0 0 20px rgba(38, 254, 220, 0.08); }
+.switch { position: relative; flex: none; width: 42px; height: 24px; border-radius: 999px; background: var(--sw-surface-highest); transition: background 0.3s ease; }
+.switch::after { content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: var(--sw-muted); transition: all 0.3s ease; }
+.addon-input:checked + .addon-box .switch { background: var(--sw-blue); }
