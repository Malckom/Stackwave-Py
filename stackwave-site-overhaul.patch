+    <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-md">{% block legal_title %}{% endblock %}</h1>
+    <p class="text-on-surface-variant text-body-lg max-w-2xl mb-sm">{% block legal_intro %}{% endblock %}</p>
+    <p class="text-on-surface-variant font-label-sm">Last updated: {{ site.legal_last_updated }}</p>
+  </header>
+  <div class="legal-layout pb-3xl">
+    <nav class="legal-toc" aria-label="On this page">
+      <h2>On this page</h2>
+      <ol>{% block legal_toc %}{% endblock %}</ol>
+    </nav>
+    <article class="prose-legal">{% block legal_body %}{% endblock %}</article>
+  </div>
+</main>
+{% endblock %}
