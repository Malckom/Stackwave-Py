+        a.href = a.dataset.base + (chosen.length ? '&addons=' + list : '') + '#inquiry-form';
+      });
+    }
+    inputs.forEach(function (i) { i.addEventListener('change', update); });
+    update();
+  })();
+</script>
 {% endblock %}
