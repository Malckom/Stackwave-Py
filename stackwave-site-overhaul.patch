+.toast--error .toast-progress { background: var(--sw-error); }
+@keyframes toast-in { from { opacity: 0; transform: translateY(-14px) scale(0.97); } to { opacity: 1; transform: none; } }
+@keyframes toast-out { to { opacity: 0; transform: translateY(-10px) scale(0.98); visibility: hidden; } }
+@keyframes toast-progress { from { transform: scaleX(1); } to { transform: scaleX(0); } }
+@keyframes toast-draw { to { stroke-dashoffset: 0; } }
+
+/* ---------- Hero (home) ---------- */
+.hero {
+  position: relative; display: flex; align-items: center; overflow: hidden;
