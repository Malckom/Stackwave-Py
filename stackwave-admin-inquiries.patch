+.admin-status dt { font-size: 12px; font-weight: 600; color: var(--sw-outline); }
+.admin-status dd { margin: 3px 0 0; font-size: 14px; color: var(--sw-text); overflow-wrap: anywhere; }
+.pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
